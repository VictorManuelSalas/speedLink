// ============================================================
// ORGANIZACIÓN (tenant raíz)
// ============================================================

model Organization {
  id               String   @id @default(cuid())
  code             String   @unique // "speedlink-mx-01"
  tradeName        String
  legalName        String?
  rfc              String?
  taxRegime        String? // clave SAT: 601, 612, 626…
  fiscalPostalCode String?
  email            String?
  phone            String?
  website          String?
  street           String?
  city             String?
  state            String?
  postalCode       String?
  logoUrl          String?
  timeZone         String   @default("America/Mexico_City")
  currency         String   @default("MXN")
  invoiceSeries    String   @default("INV")
  paymentTermsDays Int      @default(10) // días de la emisión al vencimiento
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  updatedById      String?

  sequences            Sequence[]
  taxRates             TaxRate[]
  roles                Role[]
  users                User[]
  clients              Client[]
  leads                Lead[]
  services             Service[]
  equipments           Equipment[]
  inventoryMinimums    InventoryMinimum[]
  deviceModelDefaults  DeviceModelDefault[]
  assignments          Assignment[]
  contracts            Contract[]
  invoices             Invoice[]
  payments             Payment[]
  onlinePayments       OnlinePayment[]
  expenses             Expense[]
  calendarEvents       CalendarEvent[]
  tickets              Ticket[]
  notes                Note[]
  attachments          Attachment[]
  emailMessages        EmailMessage[]
  templates            Template[]
  customModules        CustomModule[]
  customFields         CustomField[]
  nativeModuleSettings NativeModuleSetting[]
  customRecords        CustomRecord[]
  smtpConfig           SmtpConfig?
  smsConfig            SmsConfig?
  connectionSettings   ConnectionSettings?
  paymentGateway       PaymentGatewayConfig?
  cfdiConfig           CfdiConfig?
  customConnections    CustomConnection[]
  webhooks             Webhook[]
  routers              Router[]
  speedProfiles        SpeedProfile[]
  networkSubscribers   NetworkSubscriber[]
  cutoffRules          CutoffRules?
  deviceAccesses       DeviceAccess[]
  portalConfig         PortalConfig?
  portalAccesses       PortalAccess[]
  vaultSecrets         VaultSecret[]
  ipRestrictions       IpRestriction[]
  automations          Automation[]
  schedules            Schedule[]

  @@map("organizations")
}

/// Contadores por organización para folios legibles: SL, INV, TK, ASG, LD…
/// Se incrementa con UPDATE … SET next = next + 1 RETURNING (atómico).
model Sequence {
  id             String @id @default(cuid())
  organizationId String
  key            String // "clients", "invoices", "tickets", "cm_ordenes"…
  prefix         String // "SL", "INV", "TK"…
  next           Int    @default(1)
  padding        Int    @default(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("sequences")
}

model TaxRate {
  id             String    @id @default(cuid())
  organizationId String
  name           String // "IVA 16%"
  factor         TaxFactor @default(RATE)
  rate           Decimal   @db.Decimal(7, 4) // porcentaje: 16.0000
  description    String?
  isActive       Boolean   @default(true)
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  services     Service[]

  @@unique([organizationId, name])
  @@map("tax_rates")
}

// ============================================================
// USUARIOS, ROLES Y SESIONES
// ============================================================

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isSystem       Boolean  @default(false) // Administrador: todos los permisos, no editable
  /// Permisos "modulo.accion", igual que el frontend: "invoices.delete",
  /// "equipment.credentials", "network.block", "cm_ordenes.read"…
  permissions    String[] -> ///Duda: Los permisos no debe ser variable??
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organizationId, name])
  @@map("roles")
}

model User {
  id                 String     @id @default(cuid())
  organizationId     String
  roleId             String
  name               String
  email              String // siempre en minúsculas
  phone              String?
  passwordHash       String? // argon2id; null mientras la invitación no se acepta
  mustChangePassword Boolean    @default(false)
  status             UserStatus @default(INVITED)
  preferredLanguage  Language   @default(ES)
  twoFactorEnabled   Boolean    @default(false)
  twoFactorSecret    String? // cifrado
  invitedAt          DateTime?
  lastLoginAt        DateTime?
  suspendedAt        DateTime?
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role            Role            @relation(fields: [roleId], references: [id])
  sessions        UserSession[]
  tokens          UserToken[]
  ownedLeads      Lead[]          @relation("LeadOwner")
  technicianOf    Client[]        @relation("ClientTechnician")
  eventsCreated   CalendarEvent[] @relation("EventCreatedBy")
  eventsAssigned  CalendarEvent[] @relation("EventAssignedTo")
  ticketsCreated  Ticket[]        @relation("TicketCreatedBy")
  ticketsAssigned Ticket[]        @relation("TicketAssignedTo")
  ticketComments  TicketComment[] @relation("TicketCommentAuthor")
  notes           Note[]
  attachments     Attachment[]    @relation("AttachmentUploadedBy")
  emailMessages   EmailMessage[]

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@map("users")
}

/// Refresh tokens (uno por dispositivo). Se guarda el hash, nunca el token.
model UserSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

/// Invitación y restablecimiento de contraseña por enlace de un solo uso
/// (reemplaza la contraseña temporal que hoy genera el frontend).
model UserToken {
  id        String        @id @default(cuid())
  userId    String
  type      UserTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_tokens")
}

// ============================================================
// CLIENTES Y LEADS
// ============================================================

model Client {
  id             String       @id @default(cuid())
  organizationId String
  code           String // "SL-1100"
  type           ClientType   @default(HOME)
  name           String
  email          String?
  phone          String?
  cellphone      String?
  address        String?
  community      String? // comunidad / colonia
  latitude       Decimal?     @db.Decimal(9, 6)
  longitude      Decimal?     @db.Decimal(9, 6)
  status         ClientStatus @default(PENDING)
  billingDay     Int          @default(1) // 1–28
  installDate    DateTime?
  internalNotes  String?
  technicianId   String?
  customFields   Json? // valores de campos personalizados (cf_*)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  technician     User?              @relation("ClientTechnician", fields: [technicianId], references: [id])
  convertedFrom  Lead?              @relation("LeadConversion")
  assignments    Assignment[]
  contracts      Contract[]
  invoices       Invoice[]
  payments       Payment[]
  onlinePayments OnlinePayment[]
  tickets        Ticket[]
  events         CalendarEvent[]
  subscriber     NetworkSubscriber?
  portalAccess   PortalAccess?

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, name])
  @@map("clients")
}

model Lead {
  id                  String     @id @default(cuid())
  organizationId      String
  code                String // "LD-000123"
  type                ClientType @default(HOME)
  name                String
  email               String?
  phone               String?
  cellphone           String?
  address             String?
  latitude            Decimal?   @db.Decimal(9, 6)
  longitude           Decimal?   @db.Decimal(9, 6)
  source              LeadSource @default(OTHER)
  status              LeadStatus @default(NEW)
  ownerId             String?
  description         String?
  interestedPlanId    String? // plan de internet que le interesa
  convertedAt         DateTime?
  convertedToClientId String?    @unique
  customFields        Json?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  createdById         String?
  updatedById         String?
  deletedAt           DateTime?

  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner             User?           @relation("LeadOwner", fields: [ownerId], references: [id])
  interestedPlan    Service?        @relation("LeadPlan", fields: [interestedPlanId], references: [id])
  /// Servicios de streaming / complementos que le interesan.
  interestedAddons  Service[]       @relation("LeadAddons")
  convertedToClient Client?         @relation("LeadConversion", fields: [convertedToClientId], references: [id])
  events            CalendarEvent[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@map("leads")
}

// ============================================================
// SERVICIOS (catálogo de planes)
// ============================================================

model Service {
  id             String        @id @default(cuid())
  organizationId String
  code           String // "SRV-000012"
  name           String
  description    String?
  type           ServiceType   @default(INTERNET)
  status         ServiceStatus @default(ACTIVE)
  price          Decimal       @db.Decimal(12, 2)
  taxRateId      String?
  /// Solo para INTERNET: definen el perfil de velocidad del MikroTik.
  downloadMbps   Decimal?      @db.Decimal(8, 2)
  uploadMbps     Decimal?      @db.Decimal(8, 2)
  customFields   Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxRate       TaxRate?       @relation(fields: [taxRateId], references: [id])
  contractItems ContractItem[]
  invoiceItems  InvoiceItem[]
  speedProfile  SpeedProfile?
  leadsAsPlan   Lead[]         @relation("LeadPlan")
  leadsAsAddon  Lead[]         @relation("LeadAddons")

  @@unique([organizationId, code])
  @@index([organizationId, type, status])
  @@map("services")
}

// ============================================================
// EQUIPOS, INVENTARIO Y ACCESO
// ============================================================

model Equipment {
  id             String          @id @default(cuid())
  organizationId String
  code           String // "EQ-000045"
  name           String
  brand          String?
  model          String?
  /// brand + model en minúsculas: agrupa existencias y defaults por modelo.
  modelKey       String?
  serialNumber   String?
  macAddress     String? // AA:BB:CC:DD:EE:FF en mayúsculas
  status         EquipmentStatus @default(AVAILABLE)
  purchaseCost   Decimal?        @db.Decimal(12, 2)
  purchaseDate   DateTime?
  forSale        Boolean         @default(false)
  description    String?
  customFields   Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  Assignment[]
  access       DeviceAccess?

  @@unique([organizationId, code])
  @@unique([organizationId, macAddress])
  @@index([organizationId, status])
  @@index([organizationId, modelKey])
  @@map("equipments")
}

/// Stock mínimo por modelo (pantalla Existencias).
model InventoryMinimum {
  id             String @id @default(cuid())
  organizationId String
  modelKey       String
  minimum        Int    @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, modelKey])
  @@map("inventory_minimums")
}

/// Usuario e IP de fábrica sugeridos por modelo.
model DeviceModelDefault {
  id             String  @id @default(cuid())
  organizationId String
  modelKey       String
  username       String?
  ip             String?
  note           String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, modelKey])
  @@map("device_model_defaults")
}

/// Acceso de administración del equipo. La contraseña va en VaultSecret
/// (kind DEVICE_ADMIN, ownerId = equipmentId) y cada revelado se audita.
model DeviceAccess {
  equipmentId             String    @id
  organizationId          String
  managementIp            String?
  managementPort          Int?
  username                String?
  firmware                String?
  factoryPasswordChanged  Boolean?
  passwordChangedAt       DateTime?
  credentialsNeedRotation Boolean   @default(false)
  wifiNeedsReset          Boolean   @default(false)
  updatedAt               DateTime  @updatedAt
  updatedById             String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipment    Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  wifi         WifiNetwork[]

  @@unique([organizationId, managementIp])
  @@map("device_accesses")
}

/// Red WiFi del equipo. La contraseña va en VaultSecret (kind WIFI, ownerId = id).
model WifiNetwork {
  id                String       @id @default(cuid())
  equipmentId       String
  ssid              String
  band              WifiBand     @default(DUAL)
  security          WifiSecurity @default(WPA2)
  enabled           Boolean      @default(true)
  passwordChangedAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  device DeviceAccess @relation(fields: [equipmentId], references: [equipmentId], onDelete: Cascade)

  @@unique([equipmentId, ssid, band])
  @@map("wifi_networks")
}

/// Equipo entregado a un cliente. Regla: un equipo solo puede tener una
/// asignación ACTIVE (índice parcial en la migración).
model Assignment {
  id             String           @id @default(cuid())
  organizationId String
  code           String // "ASG-2026-0001"
  clientId       String
  equipmentId    String
  status         AssignmentStatus @default(ACTIVE)
  assignedAt     DateTime         @default(now())
  returnedAt     DateTime?
  description    String?
  customFields   Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id])
  equipment    Equipment    @relation(fields: [equipmentId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId, clientId])
  @@index([equipmentId, status])
  @@map("assignments")
}

// ============================================================
// CONTRATOS
// ============================================================

model Contract {
  id             String         @id @default(cuid())
  organizationId String
  contractNumber String
  clientId       String
  status         ContractStatus @default(PENDING_SIGNATURE)
  startDate      DateTime
  endDate        DateTime?
  signedAt       DateTime?
  totalMonthly   Decimal        @db.Decimal(12, 2) // suma de partidas
  description    String?
  customFields   Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client         @relation(fields: [clientId], references: [id])
  items        ContractItem[]
  invoices     Invoice[]

  @@unique([organizationId, contractNumber])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@map("contracts")
}

model ContractItem {
  id         String  @id @default(cuid())
  contractId String
  serviceId  String
  quantity   Int     @default(1)
  unitPrice  Decimal @db.Decimal(12, 2) // precio pactado (puede diferir del catálogo)
  locked     Boolean @default(false)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id])

  @@index([serviceId])
  @@map("contract_items")
}

// ============================================================
// FACTURACIÓN Y COBRANZA
// ============================================================

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  folio          String // "INV-000123"
  clientId       String
  contractId     String?
  status         InvoiceStatus @default(PENDING)
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  /// Periodo facturado: evita facturar dos veces el mismo mes de un contrato.
  periodStart    DateTime?
  periodEnd      DateTime?
  subtotal       Decimal       @db.Decimal(12, 2)
  taxRateId      String?
  taxName        String? // copia al emitir
  taxRate        Decimal       @default(0) @db.Decimal(7, 4) // copia al emitir
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  /// Suma de pagos aplicados; se actualiza en la misma transacción del pago.
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  paidAt         DateTime?
  notifiedAt     DateTime? // "Marcar como notificada"
  description    String?
  customFields   Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client          @relation(fields: [clientId], references: [id])
  contract       Contract?       @relation(fields: [contractId], references: [id])
  taxRateRef     TaxRate?        @relation(fields: [taxRateId], references: [id])
  items          InvoiceItem[]
  payments       Payment[]
  onlinePayments OnlinePayment[]
  cfdi           CfdiStamp?

  @@unique([organizationId, folio])
  @@unique([contractId, periodStart])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, clientId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  serviceId   String?
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])

  @@map("invoice_items")
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  code           String // "PAY-000321"
  clientId       String
  invoiceId      String?
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod @default(CASH)
  source         PaymentSource @default(STAFF)
  reference      String?
  paidAt         DateTime      @default(now())
  notes          String?
  customFields   Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client        Client         @relation(fields: [clientId], references: [id])
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id])
  onlinePayment OnlinePayment?

  @@unique([organizationId, code])
  @@index([organizationId, paidAt])
  @@index([organizationId, clientId])
  @@index([invoiceId])
  @@map("payments")
}

/// Intento de pago en línea desde el portal. Cuando la pasarela confirma
/// (webhook), el worker crea el Payment y lo liga aquí.
model OnlinePayment {
  id                String              @id @default(cuid())
  organizationId    String
  clientId          String
  invoiceId         String
  provider          PaymentProvider
  mode              ConnectionMode
  providerPaymentId String?
  checkoutUrl       String?
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @default("MXN")
  status            OnlinePaymentStatus @default(PENDING)
  rawStatus         String?
  paymentId         String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id])
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
  payment      Payment?     @relation(fields: [paymentId], references: [id])

  @@unique([provider, providerPaymentId])
  @@index([organizationId, status])
  @@map("online_payments")
}

/// Timbrado CFDI 4.0 de una factura.
model CfdiStamp {
  id          String       @id @default(cuid())
  invoiceId   String       @unique
  provider    CfdiProvider
  status      CfdiStatus   @default(PENDING)
  uuid        String?      @unique // folio fiscal
  xmlUrl      String?
  pdfUrl      String?
  error       String?
  stampedAt   DateTime?
  cancelledAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("cfdi_stamps")
}

model Expense {
  id             String          @id @default(cuid())
  organizationId String
  code           String // "EXP-000017"
  description    String
  vendor         String?
  category       ExpenseCategory @default(OTHER)
  amount         Decimal         @db.Decimal(12, 2)
  date           DateTime
  receiptUrl     String?
  customFields   Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, date])
  @@map("expenses")
}

// ============================================================
// CALENDARIO
// ============================================================

model CalendarEvent {
  id             String            @id @default(cuid())
  organizationId String
  title          String
  description    String?
  type           CalendarEventType @default(FOLLOW_UP)
  status         EventStatus       @default(SCHEDULED)
  startsAt       DateTime
  endsAt         DateTime
  allDay         Boolean           @default(false)
  address        String?
  clientId       String?
  leadId         String?
  ticketId       String?
  assignedToId   String? // técnico o vendedor (antes se guardaba el nombre)
  createdById    String
  completedAt    DateTime?
  reminderSentAt DateTime? // lo marca el worker al mandar el recordatorio
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id])
  ticket       Ticket?      @relation(fields: [ticketId], references: [id])
  assignedTo   User?        @relation("EventAssignedTo", fields: [assignedToId], references: [id])
  createdBy    User         @relation("EventCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, startsAt])
  @@index([organizationId, assignedToId, startsAt])
  @@map("calendar_events")
}

// ============================================================
// TICKETS
// ============================================================

model Ticket {
  id              String         @id @default(cuid())
  organizationId  String
  folio           String? // "TK-000088"
  clientId        String
  subject         String
  description     String
  category        TicketCategory @default(OTHER)
  priority        TicketPriority @default(MEDIUM)
  status          TicketStatus   @default(OPEN)
  channel         TicketChannel  @default(PHONE)
  faultType       String? // del portal: sin-internet, lento, intermitente, equipo, factura, otro
  requester       String? // quien reportó (puede no ser el titular)
  assignedToId    String?
  /// null cuando lo abrió el cliente desde el portal.
  createdById     String?
  slaDueAt        DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  customFields    Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client          @relation(fields: [clientId], references: [id])
  assignedTo   User?           @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  createdBy    User?           @relation("TicketCreatedBy", fields: [createdById], references: [id])
  comments     TicketComment[]
  attachments  Attachment[]    @relation("TicketAttachments")
  events       CalendarEvent[]

  @@unique([organizationId, folio])
  @@index([organizationId, status, priority])
  @@index([organizationId, clientId])
  @@index([organizationId, assignedToId])
  @@index([slaDueAt])
  @@map("tickets")
}

model TicketComment {
  id         String    @id @default(cuid())
  ticketId   String
  message    String
  /// Autor del equipo; null si respondió el cliente desde el portal.
  authorId   String?
  fromClient Boolean   @default(false)
  isInternal Boolean   @default(false) // interno = no se ve en el portal
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User?        @relation("TicketCommentAuthor", fields: [authorId], references: [id])
  attachments Attachment[] @relation("TicketCommentAttachments")

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

// ============================================================
// LISTAS RELACIONADAS GENÉRICAS (cualquier módulo, incluidos cm_*)
// module = clave del módulo ("clients", "invoices", "cm_ordenes"…)
// recordId = id del registro. La integridad la valida el servicio.
// ============================================================

model Note {
  id             String    @id @default(cuid())
  organizationId String
  module         String
  recordId       String
  title          String?
  message        String
  pinned         Boolean   @default(false)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])
  attachments  Attachment[] @relation("NoteAttachments")

  @@index([organizationId, module, recordId])
  @@map("notes")
}

/// Archivo en almacenamiento de objetos (S3 / R2 / MinIO). storageKey es la
/// ruta en el bucket; la descarga se sirve con URL firmada y temporal.
model Attachment {
  id               String    @id @default(cuid())
  organizationId   String
  module           String
  recordId         String
  noteId           String?
  ticketId         String?
  ticketCommentId  String?
  fileName         String
  mimeType         String
  size             Int
  storageKey       String
  visibleToClient  Boolean   @default(false) // aparece en el portal
  uploadedById     String?
  uploadedByClient Boolean   @default(false)
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy    User?          @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])
  note          Note?          @relation("NoteAttachments", fields: [noteId], references: [id], onDelete: Cascade)
  ticket        Ticket?        @relation("TicketAttachments", fields: [ticketId], references: [id], onDelete: Cascade)
  ticketComment TicketComment? @relation("TicketCommentAttachments", fields: [ticketCommentId], references: [id], onDelete: Cascade)

  @@index([organizationId, module, recordId])
  @@index([noteId])
  @@index([ticketId])
  @@index([ticketCommentId])
  @@map("attachments")
}

/// Correos del CRM: borradores editables y enviados. El envío real lo hace el
/// worker (cola "email"); el registro de entrega queda en Mongo (message_logs).
model EmailMessage {
  id                String      @id @default(cuid())
  organizationId    String
  module            String
  recordId          String
  templateId        String?
  to                String[]
  cc                String[]
  fromAddress       String?
  subject           String
  body              String
  status            EmailStatus @default(DRAFT)
  attachmentIds     String[]
  sentById          String?
  sentAt            DateTime?
  providerMessageId String?
  error             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sentBy       User?        @relation(fields: [sentById], references: [id])
  template     Template?    @relation(fields: [templateId], references: [id])

  @@index([organizationId, module, recordId])
  @@index([organizationId, status])
  @@map("email_messages")
}

// ============================================================
// PLANTILLAS (correo, SMS, WhatsApp)
// ============================================================

model Template {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  channel        TemplateChannel
  /// Módulo donde se ofrece; null = todos.
  module         String?
  format         TemplateFormat  @default(TEXT)
  subject        String? // solo correo
  body           String // con ${tokens}
  status         TemplateStatus  @default(ACTIVE)
  attachDocument Boolean         @default(false) // WhatsApp: agrega el enlace del documento
  showWhen       String[] // WhatsApp: estados del registro donde aparece
  /// Plantillas del sistema ("tpl-contract-send"…): no se eliminan. Si se
  /// borra una sembrada se marca deletedAt para no volver a sembrarla.
  systemKey      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  updatedById    String?
  deletedAt      DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emailMessages EmailMessage[]

  @@unique([organizationId, name])
  @@unique([organizationId, systemKey])
  @@index([organizationId, channel, module])
  @@map("templates")
}

// ============================================================
// MÓDULOS PERSONALIZADOS
// ============================================================

model CustomModule {
  id             String    @id @default(cuid())
  organizationId String
  key            String // "cm_ordenes_de_trabajo"
  singular       String
  plural         String
  gender         Gender    @default(M)
  description    String?
  icon           String?
  accent         String    @default("#2563eb")
  primaryLabel   String    @default("Nombre")
  idPrefix       String // 2–5 letras: "OT"
  showInMenu     Boolean   @default(true)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fields       CustomField[]
  records      CustomRecord[]

  @@unique([organizationId, key])
  @@unique([organizationId, idPrefix])
  @@map("custom_modules")
}

/// Campo personalizado. Sirve para módulos nativos (moduleKey = "clients",
/// "tickets"…) y para los cm_* (customModuleId lleno). El valor se guarda en
/// la columna customFields (JSONB) del registro.
model CustomField {
  id             String          @id @default(cuid())
  organizationId String
  moduleKey      String
  customModuleId String?
  key            String // "cf_numero_de_poste": inmutable
  label          String
  type           CustomFieldType // inmutable
  required       Boolean         @default(false)
  helpText       String?
  options        String[] // PICKLIST
  lookupModule   String? // LOOKUP
  showInList     Boolean         @default(false)
  order          Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customModule CustomModule? @relation(fields: [customModuleId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleKey, key])
  @@unique([organizationId, moduleKey, label])
  @@map("custom_fields")
}

/// Ajustes de módulos nativos (ocultarlos del menú).
model NativeModuleSetting {
  id             String  @id @default(cuid())
  organizationId String
  moduleKey      String
  hiddenInMenu   Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleKey])
  @@map("native_module_settings")
}

/// Registro de un módulo personalizado. data = { cf_*: valor } (JSONB con
/// índice GIN en la migración para filtrar por campo).
model CustomRecord {
  id             String    @id @default(cuid())
  organizationId String
  moduleId       String
  code           String // "OT-000001"
  name           String
  data           Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module       CustomModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([moduleId, createdAt])
  @@map("custom_records")
}

// ============================================================
// CANALES Y CONEXIONES
// ============================================================

/// La contraseña va en VaultSecret (kind SMTP).
model SmtpConfig {
  id             String       @id @default(cuid())
  organizationId String       @unique
  enabled        Boolean      @default(false)
  host           String?
  port           Int          @default(587)
  security       SmtpSecurity @default(STARTTLS)
  username       String?
  fromName       String?
  fromEmail      String?
  replyTo        String?
  secretTail     String?
  updatedAt      DateTime     @updatedAt
  updatedById    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("smtp_configs")
}

/// El token va en VaultSecret (kind SMS).
model SmsConfig {
  id             String        @id @default(cuid())
  organizationId String        @unique
  enabled        Boolean       @default(false)
  provider       SmsProvider   @default(TWILIO)
  accountId      String?
  senderType     SmsSenderType @default(NUMBER)
  sender         String?
  quietHours     Boolean       @default(true)
  quietStart     String        @default("21:00") // HH:MM, puede cruzar medianoche
  quietEnd       String        @default("08:00")
  secretTail     String?
  updatedAt      DateTime      @updatedAt
  updatedById    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("sms_configs")
}

/// Mapas y WhatsApp (manual por wa.me).
model ConnectionSettings {
  id                  String   @id @default(cuid())
  organizationId      String   @unique
  mapsApiKey          String? // llave de navegador (restringida por dominio)
  whatsappCountryCode String   @default("52")
  updatedAt           DateTime @updatedAt
  updatedById         String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("connection_settings")
}

/// Pasarela de pago del portal. La llave secreta va en VaultSecret (PAYMENTS).
model PaymentGatewayConfig {
  id             String          @id @default(cuid())
  organizationId String          @unique
  enabled        Boolean         @default(false)
  provider       PaymentProvider @default(CONEKTA)
  mode           ConnectionMode  @default(SANDBOX)
  publicKey      String?
  secretTail     String?
  secretSetAt    DateTime?
  updatedAt      DateTime        @updatedAt
  updatedById    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("payment_gateway_configs")
}

/// PAC para timbrar. La contraseña va en VaultSecret (CFDI).
model CfdiConfig {
  id             String         @id @default(cuid())
  organizationId String         @unique
  enabled        Boolean        @default(false)
  provider       CfdiProvider   @default(FACTURAMA)
  mode           ConnectionMode @default(SANDBOX)
  username       String?
  secretTail     String?
  secretSetAt    DateTime?
  updatedAt      DateTime       @updatedAt
  updatedById    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("cfdi_configs")
}

/// API de terceros (ERP, contabilidad…). La llave va en VaultSecret.
model CustomConnection {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  baseUrl        String
  authType       HttpAuthType @default(NONE)
  authName       String? // header de API key o usuario de Basic
  headers        Json         @default("[]") // [{ name, value }]
  secretTail     String?
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  updatedById    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  webhooks     Webhook[]

  @@unique([organizationId, name])
  @@map("custom_connections")
}

/// Aviso saliente. Las entregas (y reintentos) quedan en Mongo
/// (webhook_deliveries). Firma HMAC con VaultSecret (WEBHOOK_SIGNING).
model Webhook {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  event          WebhookEvent
  connectionId   String?
  target         String // ruta si hay conexión, URL completa si no
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  updatedById    String?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   CustomConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([organizationId, event, enabled])
  @@map("webhooks")
}

// ============================================================
// RED · MIKROTIK
// ============================================================

/// La contraseña del usuario API va en VaultSecret (ROUTER).
model Router {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  node           String? // torre / sitio
  host           String
  port           Int       @default(443)
  api            RouterApi @default(REST)
  username       String
  secretTail     String?
  enabled        Boolean   @default(true)
  simulated      Boolean   @default(false) // router de demostración
  blockList      String    @default("morosos") // address-list de cortes
  identity       String?
  version        String?
  lastCheckAt    DateTime?
  lastCheckOk    Boolean?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  updatedById    String?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscribers  NetworkSubscriber[]

  @@unique([organizationId, host])
  @@map("routers")
}

/// Perfil de velocidad. Si serviceId está lleno, se sincroniza con el
/// servicio de Internet (crear/editar/eliminar el servicio lo actualiza).
model SpeedProfile {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  downloadMbps   Decimal  @db.Decimal(8, 2)
  uploadMbps     Decimal  @db.Decimal(8, 2)
  burst          Boolean  @default(false)
  serviceId      String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@unique([organizationId, name])
  @@map("speed_profiles")
}

/// Cola simple (/queue simple) de un cliente. Velocidad null = la del plan.
model NetworkSubscriber {
  id               String            @id @default(cuid())
  organizationId   String
  clientId         String            @unique
  routerId         String
  queueName        String
  ip               String
  downloadOverride Decimal?          @db.Decimal(8, 2)
  uploadOverride   Decimal?          @db.Decimal(8, 2)
  burst            Boolean           @default(false)
  blocked          Boolean           @default(false)
  blockedAt        DateTime?
  blockReason      BlockReason?
  blockNote        String?
  countersResetAt  DateTime?
  syncStatus       NetworkSyncStatus @default(PENDING)
  lastSyncAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  updatedById      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  router       Router       @relation(fields: [routerId], references: [id])

  @@unique([routerId, queueName])
  @@unique([organizationId, ip])
  @@index([organizationId, blocked])
  @@map("network_subscribers")
}

/// Reglas de corte automático (las ejecuta el worker).
model CutoffRules {
  id                  String   @id @default(cuid())
  organizationId      String   @unique
  enabled             Boolean  @default(false)
  graceDays           Int      @default(5) // 0–60
  windowStart         String   @default("09:00") // HH:MM
  windowEnd           String   @default("18:00")
  skipWeekends        Boolean  @default(true)
  reactivateOnPayment Boolean  @default(true)
  notifyWhatsapp      Boolean  @default(true)
  updatedAt           DateTime @updatedAt
  updatedById         String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("cutoff_rules")
}

// ============================================================
// PORTAL DE CLIENTES
// ============================================================

model PortalConfig {
  id                  String   @id @default(cuid())
  organizationId      String   @unique
  name                String
  slug                String   @unique // global: es la URL pública
  previousSlugs       String[] // redirigen al actual (máx. 5)
  enabled             Boolean  @default(false)
  showInvoices        Boolean  @default(true)
  showPayments        Boolean  @default(true)
  showTickets         Boolean  @default(true)
  showAttachments     Boolean  @default(false)
  showWifi            Boolean  @default(false)
  allowProfileEdit    Boolean  @default(false)
  allowTicketCreation Boolean  @default(true)
  allowFileUpload     Boolean  @default(false)
  allowOnlinePayment  Boolean  @default(false)
  primaryColor        String   @default("#2563EB")
  supportEmail        String?
  updatedAt           DateTime @updatedAt
  updatedById         String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("portal_configs")
}

/// Acceso del cliente al portal: número de cliente + PIN (hash, nunca en claro).
model PortalAccess {
  id             String             @id @default(cuid())
  organizationId String
  clientId       String             @unique
  pinHash        String
  status         PortalAccessStatus @default(ACTIVE)
  failedAttempts Int                @default(0)
  lockedUntil    DateTime?
  invitedAt      DateTime?
  lastLoginAt    DateTime?
  updatedAt      DateTime           @updatedAt
  updatedById    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("portal_accesses")
}

// ============================================================
// BÓVEDA DE SECRETOS
// AES-256-GCM con llave maestra fuera de la base (KMS o variable
// VAULT_MASTER_KEY). keyVersion permite rotar la llave maestra.
// Cada revelado (credenciales de equipo, WiFi) se audita en Mongo.
// ============================================================

model VaultSecret {
  id             String     @id @default(cuid())
  organizationId String
  kind           SecretKind
  ownerId        String // id del equipo, red WiFi, router, conexión, webhook u organización
  ciphertext     String
  iv             String
  authTag        String
  keyVersion     Int        @default(1)
  tail           String? // últimos 4 para mostrar
  createdAt      DateTime   @default(now())
  rotatedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, ownerId])
  @@map("vault_secrets")
}

// ============================================================
// SEGURIDAD Y AUTOMATIZACIÓN
// ============================================================

model IpRestriction {
  id             String   @id @default(cuid())
  organizationId String
  cidr           String // "192.168.1.0/24" o IP exacta
  description    String?
  isAllowed      Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("ip_restrictions")
}

/// Regla "cuando pase X y se cumpla Y, haz Z" (factura vencida → correo,
/// ticket urgente → avisar supervisor…). La evalúa el worker.
model Automation {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  triggerModule  String
  triggerEvent   String // "created", "updated", "status_changed", "overdue"…
  conditions     Json      @default("[]")
  actions        Json // [{ type: "send_template", templateId }, { type: "assign", userId }…]
  enabled        Boolean   @default(true)
  runCount       Int       @default(0)
  lastRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, triggerModule, enabled])
  @@map("automations")
}

/// Tareas programadas por organización (facturación del mes, recordatorios,
/// cortes, cierre diario). El worker las registra como repeatable jobs de
/// BullMQ; cada ejecución queda en Mongo (job_runs).
model Schedule {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  job            String // "billing.generate", "invoices.remind", "network.cutoff"…
  cron           String // "0 9 1 * *"
  timeZone       String         @default("America/Mexico_City")
  payload        Json?
  status         ScheduleStatus @default(ACTIVE)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, job])
  @@map("schedules")
}

// ============================================================
// OUTBOX DE EVENTOS
// Se escribe en la MISMA transacción que el cambio de negocio (pago, factura,
// bloqueo…). Un relay del worker lo lee y reparte a las colas: webhooks,
// actividad, notificaciones, automatizaciones. Así ningún evento se pierde
// aunque la API se caiga justo después de guardar.
// ============================================================

model OutboxEvent {
  id             String    @id @default(cuid())
  organizationId String
  /// "payment.created", "invoice.paid", "network.blocked"…
  type           String
  module         String?
  recordId       String?
  payload        Json
  actorId        String?
  createdAt      DateTime  @default(now())
  processedAt    DateTime?
  attempts       Int       @default(0)
  error          String?

  @@index([processedAt, createdAt])
  @@index([organizationId, type, createdAt])
  @@map("outbox_events")
}
