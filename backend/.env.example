# Copia este archivo a .env (no se sube a git) y llena los valores.

# APP
PORT=3000
NODE_ENV=development
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:4200
# URL pública del CRM (enlaces en correos y WhatsApp)
APP_PUBLIC_URL=http://localhost:4200

# POSTGRES
POSTGRES_USER=speedlink
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=speedlink
DATABASE_URL=postgresql://speedlink:cambia-esto@postgres:5432/speedlink?schema=public

# MONGO
MONGO_URL=mongodb://mongo:27017/speedlink

# REDIS (colas BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# AUTH: genera cada una con `openssl rand -base64 48`
JWT_SECRET=
JWT_REFRESH_SECRET=
# Firma de los enlaces públicos de documentos (/d/invoice/…)
DOCUMENT_LINK_SECRET=

# BÓVEDA: llave de 32 bytes en base64 (`openssl rand -base64 32`) para cifrar
# contraseñas de equipos, WiFi, routers, SMTP, SMS, pagos y CFDI.
VAULT_MASTER_KEY=
VAULT_KEY_VERSION=1

# ARCHIVOS (S3 / Cloudflare R2 / MinIO)
STORAGE_ENDPOINT=
STORAGE_BUCKET=speedlink-files
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
